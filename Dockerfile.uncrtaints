FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    python3-dev \
    build-essential \
    git \
    ca-certificates \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/setup
COPY requirements.txt /opt/setup/requirements.txt
COPY requirements-uncrtaints.txt /opt/setup/requirements-uncrtaints.txt

RUN python3.10 -m pip install --upgrade pip setuptools wheel

# Install CUDA-enabled PyTorch first, then install benchmark deps excluding torch pin.
RUN python3.10 -m pip install --index-url https://download.pytorch.org/whl/cu121 \
    torch==2.2.1+cu121 torchvision==0.17.1+cu121 torchaudio==2.2.1+cu121

RUN grep -vi '^torch' /opt/setup/requirements.txt > /opt/setup/requirements-no-torch.txt \
    && python3.10 -m pip install -r /opt/setup/requirements-no-torch.txt

RUN python3.10 -m pip install -r /opt/setup/requirements-uncrtaints.txt

WORKDIR /workspace
ENTRYPOINT ["bash"]
